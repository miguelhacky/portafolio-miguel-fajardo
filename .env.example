# Configuración opcional del portafolio.
# Copia este archivo como .env y completa solo lo que ya exista realmente.
# Las variables vacías mantienen ocultos el correo y el formulario.
# La hoja de vida y el botón de WhatsApp ya están configurados en
# src/data/portfolio.ts y no necesitan variables de entorno.

# Correo público (se muestra en Contacto).
VITE_CONTACT_EMAIL=

# Endpoint de un servicio como Formspree para activar el formulario.
# Ejemplo: https://formspree.io/f/xxxxxxxx
VITE_FORM_ENDPOINT=

# Opcional: sobrescribe la ruta pública del CV (por defecto
# /documentos/hoja-de-vida-miguel-fajardo.pdf). El nombre de descarga se define
# en profile.resumeFileName dentro de src/data/portfolio.ts.
VITE_RESUME_URL=
